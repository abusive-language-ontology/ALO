            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Represents prejudice, discrimination, hostility, or hatred directed toward individuals or groups based on their Catholic faith or affiliation</rdfs:comment>
        <rdfs:label xml:lang="en">AntiCatholic</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AntiCroatian -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AntiCroatian">
