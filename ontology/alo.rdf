<?xml version="1.0"?>
<rdf:RDF xmlns="http://llod.jerteh.rs/alo/alo.owl#"
     xml:base="http://llod.jerteh.rs/alo/alo.owl"
     xmlns:alo="http://llod.jerteh.rs/alo/alo.owl#"
     xmlns:nif="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:ontolex="http://www.w3.org/ns/lemon/ontolex#">
    <owl:Ontology rdf:about="http://llod.jerteh.rs/alo/alo.owl">
        <owl:versionIRI rdf:resource="http://llod.jerteh.rs/alo/alo.owl/1.0.0"/>
        <terms:abstract xml:lang="en">The ontology of abusive speech is designed for publishing results of the abusive language annotation process in a structured form. The goal is to have a placeholder for different dataset formats, to support diverse abusive language detection methodologies and content providers.</terms:abstract>
        <terms:created xml:lang="en">2025-03-01</terms:created>
        <terms:creator xml:lang="en">Danka Jokic, University of Belgrade</terms:creator>
        <terms:description xml:lang="en">The ontology of abusive speech is designed for publishing results of the abusive language annotation process in a structured form. The goal is to have a placeholder for different dataset formats, to support diverse abusive language detection methodologies and content providers.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by-nc-sa/4.0/"/>
        <terms:modified xml:lang="en">02-07-2026</terms:modified>
        <terms:publisher xml:lang="en">University of Belgrade</terms:publisher>
        <terms:rightsHolder xml:lang="en">Danka Jokic</terms:rightsHolder>
        <terms:title xml:lang="en">Abusive Language Ontology (Alo)</terms:title>
        <vann:preferredNamespacePrefix xml:lang="en">alo</vann:preferredNamespacePrefix>
        <vann:preferredNamespacePrefix xml:lang="en">http://llod.jerteh.rs/alo/alo.owl#</vann:preferredNamespacePrefix>
        <rdfs:comment xml:lang="en">The ontology of abusive speech is designed for publishing results of the abusive language annotation process in a structured form. The goal is to have a placeholder for different dataset formats, to support diverse abusive language detection methodologies and content providers.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://github.com/danka-jokic/ALO"/>
        <owl:versionInfo xml:lang="en">1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/abstract -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/abstract"/>
    


    <!-- http://purl.org/dc/terms/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/rightsHolder -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/rightsHolder"/>
    


    <!-- http://purl.org/dc/terms/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2002/07/owl#imports -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#imports"/>
    


    <!-- http://www.w3.org/ns/prov#category -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#category"/>
    


    <!-- http://www.w3.org/ns/prov#component -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#component"/>
    


    <!-- http://www.w3.org/ns/prov#constraints -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#constraints">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/ns/prov#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#definition"/>
    


    <!-- http://www.w3.org/ns/prov#dm -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#dm"/>
    


    <!-- http://www.w3.org/ns/prov#editorialNote -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#editorialNote"/>
    


    <!-- http://www.w3.org/ns/prov#inverse -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#inverse"/>
    


    <!-- http://www.w3.org/ns/prov#n -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#n"/>
    


    <!-- http://www.w3.org/ns/prov#sharesDefinitionWith -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/ns/prov#sharesDefinitionWith"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://llod.jerteh.rs/alo/alo.owl#analysisPerformedBy -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#analysisPerformedBy">
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveLanguageAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">Relates an abusive speech analysis to the agent, system, or annotator that performed it.</rdfs:comment>
        <rdfs:label xml:lang="en">analysisPerformedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#annotationPerformedBy -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#annotationPerformedBy">
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Annotation"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">Relates an annotation to the annotator, agent, or system that created it (class Agent).</rdfs:comment>
        <rdfs:label xml:lang="en">annotationPerformedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#belongsToTargetGroup -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#belongsToTargetGroup">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetGroup"/>
        <rdfs:comment xml:lang="en">Targets can belong to Target Groups for course grained annotation.</rdfs:comment>
        <rdfs:label xml:lang="en">belongsToTargetGroup</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#containsEntry -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#containsEntry">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Dataset"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#DatasetEntry"/>
        <rdfs:comment xml:lang="en">A dataset contains dataset entries.</rdfs:comment>
        <rdfs:label xml:lang="en">containsEntry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasAbuseCategory -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasAbuseCategory">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbuseCategory"/>
        <rdfs:comment xml:lang="en">Relates abusive speech to the category of abuse it expresses.</rdfs:comment>
        <rdfs:label xml:lang="en">hasAbuseCategory</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasAbusiveSpeech -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasAbusiveSpeech">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusivenessSet"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:comment xml:lang="en">Relates an abusiveness set to abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">hasAbusiveSpeech</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasAbusiveText -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasAbusiveText">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusivenessSet"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveText"/>
        <rdfs:comment xml:lang="en">Relates an abusiveness set to abusive text that contains abusive content.</rdfs:comment>
        <rdfs:label xml:lang="en">hasAbusiveText</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasAbusivenessAnalysis -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasAbusivenessAnalysis">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#DatasetEntry"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveLanguageAnalysis"/>
        <rdfs:comment xml:lang="en">Relates a dataset entry to abusive language analysis perfomed on it</rdfs:comment>
        <rdfs:label xml:lang="en">hasAbusivenessAnalysis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasAnalysis -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasAnalysis">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Annotation"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveLanguageAnalysis"/>
        <rdfs:comment xml:lang="en">Annotation activity is performed by analyzing data entries for abusive speech detection.</rdfs:comment>
        <rdfs:label xml:lang="en">hasAnalysis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasAnnotation -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasAnnotation">
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Dataset"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Annotation"/>
        <rdfs:comment xml:lang="en">A dataset can have one or more annotations performed on the dataset.</rdfs:comment>
        <rdfs:label xml:lang="en">hasAnnotation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasAnnotationLevel -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasAnnotationLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Annotation"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AnnotationLevel"/>
        <rdfs:comment xml:lang="en">A class defines if annotation is performed on the whole text, sentence level or text spans.</rdfs:comment>
        <rdfs:label xml:lang="en">hasAnnotationLevel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasHateConcept -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasHateConcept">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isHateConceptOf"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#HateConcept"/>
        <rdfs:comment xml:lang="en">Relates abusive speech to the hate-related concept expressed or targeted in it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasHateConcept</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasIntenton -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasIntenton">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Intention"/>
        <rdfs:comment xml:lang="en">Relates abusive speech to the intention or communicative purpose behind it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasIntenton</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasLexicalRootIn -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasLexicalRootIn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#LexicalSourceConcept"/>
        <rdfs:comment xml:lang="en">Relates abusive speech to the lexical source concept which it is derived from.</rdfs:comment>
        <rdfs:label xml:lang="en">hasLexicalRootIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasLexicalUnitType -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasLexicalUnitType">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/ontolex#LexicalEntry"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#LexicalUnit"/>
        <rdfs:comment xml:lang="en">Associates a lexical entry with its lexical unit type, indicating whether it represents a word, multiword expression, idiom, catchphrase, filler, proverb, or another lexical unit category.</rdfs:comment>
        <rdfs:label xml:lang="en">hasLexicalUnitType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasNIFAnchor -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasNIFAnchor">
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveText"/>
        <rdfs:range rdf:resource="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#String"/>
        <rdfs:comment xml:lang="en">Relates an abusive text to its NIF anchor string.</rdfs:comment>
        <rdfs:label xml:lang="en">hasNIFAnchor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasSentiment -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasSentiment">
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#DatasetEntry"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Sentiment"/>
        <rdfs:comment xml:lang="en">Relates sentiment to the dataset entry where the sentiment annotation was found or perfrmed.</rdfs:comment>
        <rdfs:label xml:lang="en">hasSentiment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasTarget -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasTarget">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Target"/>
        <rdfs:comment xml:lang="en">Relates abusive speech to the individual, group, or entity targeted by it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasTarget</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasTargetGroup -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasTargetGroup">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetGroup"/>
        <rdfs:comment xml:lang="en">Relates abusive speech to the group targeted by it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasTargetGroup</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasTargetType -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasTargetType">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isTargetTypeOf"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Relates abusive speech to the target type on the basis of which it is directed toward an individual or group.</rdfs:comment>
        <rdfs:label xml:lang="en">hasTargetType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#involvesRole -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#involvesRole">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#ParticipantRole"/>
        <rdfs:comment xml:lang="en">Relates an abusive speech instance or interaction to the participant role involved in it.</rdfs:comment>
        <rdfs:label xml:lang="en">involvesRole</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst">
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#HateConcept"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Relates a hate concept to the target type on the basis of which an individual or group is targeted.</rdfs:comment>
        <rdfs:label xml:lang="en">isDirectedAgainst</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#isHateConceptOf -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#isHateConceptOf">
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#HateConcept"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:comment xml:lang="en">Relates hate concept to abusive speech where it was detected.</rdfs:comment>
        <rdfs:label xml:lang="en">isHateConceptOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#isTargetTypeOf -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#isTargetTypeOf">
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:comment xml:lang="en">Relates terget type to abusive speech is it detected in.</rdfs:comment>
        <rdfs:label xml:lang="en">isTargetTypeOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#occursInContext -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#occursInContext">
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Dataset"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Context"/>
        <rdfs:comment xml:lang="en">Relates fataset to the communicative, social, or textual context in which it occurs.</rdfs:comment>
        <rdfs:label xml:lang="en">occursInContext</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#promotesAbusiveLanguage -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#promotesAbusiveLanguage">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Incitement"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:comment xml:lang="en">Relates incitement to the abusive language or harmful expression it promotes.</rdfs:comment>
        <rdfs:label xml:lang="en">promotesAbusiveLanguage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#refersToLexicalEntry -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#refersToLexicalEntry">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#AbusiveText"/>
                    <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#DatasetEntry"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/ns/lemon/ontolex#LexicalEntry"/>
        <rdfs:comment xml:lang="en">Connects AbusiveText to Lexical Entry in an Ontolex Dictionary</rdfs:comment>
        <rdfs:label xml:lang="en">refersToLexicalEntry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#refersToLexicalSense -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#refersToLexicalSense">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#AbusiveText"/>
                    <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#DatasetEntry"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/ns/lemon/ontolex#LexicalSense"/>
        <rdfs:comment xml:lang="en">Connects AbusiveText to lexical sense of an entry in an Ontolex dictionary.</rdfs:comment>
        <rdfs:label xml:lang="en">refersToLexicalSense</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#triggersIncitement -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#triggersIncitement">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Incitement"/>
        <rdfs:comment xml:lang="en">Relates abusive speech to incitement that it may provoke, encourage, or trigger.</rdfs:comment>
        <rdfs:label xml:lang="en">triggersIncitement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#usesRethoricalFigure -->

    <owl:ObjectProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#usesRethoricalFigure">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#RhetoricalFigure"/>
        <rdfs:comment xml:lang="en">Relates abusive speech to the rhetorical figure or stylistic device used in it.</rdfs:comment>
        <rdfs:label xml:lang="en">usesRethoricalFigure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2002/07/owl#topObjectProperty -->

    <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#topObjectProperty">
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Context"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/prov#generated -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#generated">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#influenced"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveLanguageAnalysis"/>
        <rdfs:range rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusivenessSet"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov#"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o-inverses#"/>
        <rdfs:label>generated</rdfs:label>
        <prov:category>expanded</prov:category>
        <prov:component>entities-activities</prov:component>
        <prov:editorialNote xml:lang="en">prov:generated is one of few inverse property defined, to allow Activity-oriented assertions in addition to Entity-oriented assertions.</prov:editorialNote>
        <prov:inverse>wasGeneratedBy</prov:inverse>
        <prov:sharesDefinitionWith rdf:resource="http://www.w3.org/ns/prov#Generation"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#influenced -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#influenced"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://llod.jerteh.rs/alo/alo.owl#abusiveBoolean -->

    <owl:DatatypeProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#abusiveBoolean">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusivenessSet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Boolean, if 0 not abusive language, if 1 abusive language.</rdfs:comment>
        <rdfs:label xml:lang="en">abusiveBoolean</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#abusiveText -->

    <owl:DatatypeProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#abusiveText">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveText"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">Text that is result or scope of annotation process. It could be same text as in data entry or part of that text either a sentence or text span.</rdfs:comment>
        <rdfs:label xml:lang="en">abusiveText</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#abusivenessScore -->

    <owl:DatatypeProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#abusivenessScore">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
                    <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#AbusivenessSet"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">1.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Abusiveness expressed as number between 0 and 1.</rdfs:comment>
        <rdfs:label xml:lang="en">abusivenessScore</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#awareness -->

    <owl:DatatypeProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#awareness">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusivenessSet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Intentional abusive speech has value 1, unintentional has value 0.</rdfs:comment>
        <rdfs:label xml:lang="en">awareness</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#datasetSource -->

    <owl:DatatypeProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#datasetSource">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Dataset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A string placeholder containing a link or short description of dataset provenance (e.g. Twitter, reference to paper, link to github etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">datasetSource</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#disturbingContentBoolean -->

    <owl:DatatypeProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#disturbingContentBoolean">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusivenessSet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the content is considered disturbing.</rdfs:comment>
        <rdfs:label xml:lang="en">disturbingContentBoolean</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#entryId -->

    <owl:DatatypeProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#entryId">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#DatasetEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">EntryId contains reference number to external source of data entry.</rdfs:comment>
        <rdfs:label xml:lang="en">entryId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#explicitness -->

    <owl:DatatypeProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#explicitness">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusivenessSet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Abusive speech can be explicit or implicit (vailed). Explicit abusive speech has value 1, implicit has value 0.</rdfs:comment>
        <rdfs:label xml:lang="en">explicitness</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#expression -->

    <owl:DatatypeProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#expression">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/ontolex#LexicalSense"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">A typical expression or phrase associated with a lexical sense.</rdfs:comment>
        <rdfs:label xml:lang="en">expression</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#hasThreat -->

    <owl:DatatypeProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#hasThreat">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the content contains a threat.</rdfs:comment>
        <rdfs:label xml:lang="en">hasThreat</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#labeledTextEmbedding -->

    <owl:DatatypeProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#labeledTextEmbedding">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#AbusiveText"/>
                    <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#DatasetEntry"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The embedding vector of the texcual data.</rdfs:comment>
        <rdfs:label xml:lang="en">embeddingVector</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#negativeConnotation -->

    <owl:DatatypeProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#negativeConnotation">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the content has negative connotation.</rdfs:comment>
        <rdfs:label xml:lang="en">negativeConnotation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#sourceText -->

    <owl:DatatypeProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#sourceText">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#AbusiveText"/>
                    <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#DatasetEntry"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">Data entry contains text that is subject of annotation.</rdfs:comment>
        <rdfs:label xml:lang="en">sourceText</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#stereotype -->

    <owl:DatatypeProperty rdf:about="http://llod.jerteh.rs/alo/alo.owl#stereotype">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/ontolex#LexicalSense"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">Indicates whether the lexical entry may be used in a stereotypical meaning or context</rdfs:comment>
        <rdfs:label xml:lang="en">stereotype</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Ableism -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Ableism">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#HateConcept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Disability"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Ableism is discrimination and social prejudice against people with disabilities based on the belief that typical abilities (those of non-disabled people) are superior. It is a system of beliefs, practices, and societal structures that devalues and discriminates against people with physical, intellectual, sensory, mental, or developmental disabilities.</rdfs:comment>
        <rdfs:label xml:lang="en">Ableism</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AbuseCategory -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AbuseCategory">
        <rdfs:comment xml:lang="en">Abusive language is hurtful language that a speaker uses to insult or offend another individual or a group of individuals based on their personal qualities, appearance, social status, opinions, statements, or actions (Casseli, 2020).</rdfs:comment>
        <rdfs:label xml:lang="en">AbuseCategory</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AbusiveLanguageAnalysis -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AbusiveLanguageAnalysis">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">Abusive language analysis is an activity performed on a text in order to detect if the text contains abusive language.</rdfs:comment>
        <rdfs:label xml:lang="en">AbusiveLanguageAnalysis</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AbusiveSpeech">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#abusivenessScore"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</xsd:minInclusive>
                            </rdf:Description>
                            <rdf:Description>
                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">1.0</xsd:maxInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Class that represents Abusive Speech concept.</rdfs:comment>
        <rdfs:label xml:lang="en">AbusiveSpeech</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AbusiveText -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AbusiveText">
        <rdfs:comment xml:lang="en">AbusiveText represents a textual resource that has been annotated as containing abusive language, regardless of the specific linguistic realization, target, or abusive category.</rdfs:comment>
        <rdfs:label xml:lang="en">AbusiveText</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AbusivenessSet -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AbusivenessSet">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#abusivenessScore"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</xsd:minInclusive>
                            </rdf:Description>
                            <rdf:Description>
                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">1.0</xsd:maxInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A class that holds results of abusive language analysis performed on a text.</rdfs:comment>
        <rdfs:label xml:lang="en">AbusivenessSet</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Adultism -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Adultism">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Ageism"/>
        <rdfs:comment xml:lang="en">Adultism is a term used to describe the systemic bias, prejudice, and discrimination that adults (particularly those in positions of power) may hold or exhibit against young people.</rdfs:comment>
        <rdfs:label xml:lang="en">Adultism</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Age -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Age">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents age as a characteristic on the basis of which an individual or group may be targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Age</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Ageism -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Ageism">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#HateConcept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Age"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Ageism refers to stereotyping, prejudice, and/or discrimination against individuals or groups on the basis of their age.</rdfs:comment>
        <rdfs:label xml:lang="en">Ageism</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Albanian -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Albanian">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Nationality"/>
        <rdfs:comment xml:lang="en">Represents Albanian national affiliation as a characteristic that may serve as the basis for targeting an individual or group with abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Albanian</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Alcoholism -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Alcoholism">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Behaviour"/>
        <rdfs:comment xml:lang="en">Represents alcohol dependence as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Alcoholism</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Animal -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Animal">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#LexicalSourceConcept"/>
        <rdfs:comment xml:lang="en">Represents the semantic domain of animals from which abusive lexical expressions may be derived through metaphorical or pejorative usage.</rdfs:comment>
        <rdfs:label xml:lang="en">Animal</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Annotation -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Annotation">
        <rdfs:comment xml:lang="en">A class that contains high level details of annotation performed on a dataset.</rdfs:comment>
        <rdfs:label xml:lang="en">Annotation</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AnnotationLevel -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AnnotationLevel">
        <rdfs:comment xml:lang="en">Annotation Level class represents different types of annotation on a text.</rdfs:comment>
        <rdfs:label xml:lang="en">AnnotationLevel</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AntiAlbanian -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AntiAlbanian">
