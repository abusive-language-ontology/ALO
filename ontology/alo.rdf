            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#SexualOrientation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Represents prejudice, discrimination, hostility, or hatred directed toward individuals or groups based on their sexual orientation, gender identity, or gender expression.</rdfs:comment>
        <rdfs:label xml:lang="en">AntiLGBTQPlus</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AntiMuslim -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AntiMuslim">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#ReligiousHatred"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Muslim"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AntiNonMuslim"/>
        <rdfs:comment xml:lang="en">Represents prejudice, discrimination, hostility, or hatred directed toward individuals or groups based on their Muslim faith or affiliation</rdfs:comment>
        <rdfs:label xml:lang="en">AntiMuslim</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AntiNonMuslim -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AntiNonMuslim">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#ReligiousHatred"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#Catholic"/>
                            <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#Orthodox"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Represents prejudice, discrimination, hostility, or hatred directed toward individuals or groups who do not profess the Muslim faith.</rdfs:comment>
        <rdfs:label xml:lang="en">AntiNonMuslim</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AntiOrthodox -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AntiOrthodox">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#ReligiousHatred"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Orthodox"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Represents prejudice, discrimination, hostility, or hatred directed toward individuals or groups based on their Orthodox faith or affiliation</rdfs:comment>
        <rdfs:label xml:lang="en">AntiOrthodox</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AntiRefugee -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AntiRefugee">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Xenophobia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Refugee"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Represents prejudice, discrimination, hostility, or hatred directed toward refugees or individuals perceived to be refugees.</rdfs:comment>
        <rdfs:label xml:lang="en">AntiRefugee</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AntiSemitism -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AntiSemitism">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#ReligiousHatred"/>
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Xenophobia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Jew"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Represents prejudice, discrimination, hostility, or hatred directed toward Jewish individuals or communities based on their Jewish identity, ethnicity, religion, or heritage.</rdfs:comment>
        <rdfs:label xml:lang="en">AntiSemitism</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AntiSerb -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AntiSerb">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Xenophobia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Serb"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Represents prejudice, discrimination, hostility, or hatred directed toward individuals or groups based on their Serbian ethnic or national identity.</rdfs:comment>
        <rdfs:label xml:lang="en">AntiSerb</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Antigypsysm -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Antigypsysm">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Racism"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Roma"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Antigypsyism is a historically constructed, persistent complex of stereotyped perceptions, prejudice, and discrimination that leads to social exclusion and violence against Romani people. It includes hostility, prejudice, and the assignment of collective negative traits to people identified as &quot;Gypsies.&quot;   
Anti-gypsyism is recognized by international bodies like the Council of Europe, the European Union, and the OSCE as a specific type of racism.</rdfs:comment>
        <rdfs:label xml:lang="en">Antigypsysm</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Assistant -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Assistant">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#ParticipantRole"/>
        <rdfs:comment xml:lang="en">Represents a participant who supports, encourages, or helps the perpetrator in carrying out or amplifying abusive behavior.</rdfs:comment>
        <rdfs:label xml:lang="en">Assistant</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Behaviour -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Behaviour">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents behaviour or conduct as a characteristic on the basis of which a person or group may be targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Behaviour</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Biphobia -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Biphobia">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AntiLGBTQPlus"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#BisexualPerson"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Biphobia is the fear, hatred, discomfort, prejudice, discrimination, or aversion directed towards bisexual people or bisexuality.</rdfs:comment>
        <rdfs:label xml:lang="en">Biphobia</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#BisexualPerson -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#BisexualPerson">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#SexualOrientation"/>
        <owl:disjointWith rdf:resource="http://llod.jerteh.rs/alo/alo.owl#HomosexualPerson"/>
        <rdfs:comment xml:lang="en">Represents bisexual individuals or groups as the targets of abusive speech based on their sexual orientation.</rdfs:comment>
        <rdfs:label xml:lang="en">BisexualPerson</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Bosniac -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Bosniac">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Nationality"/>
        <rdfs:comment xml:lang="en">Represents Bosniac national affiliation as a characteristic that may serve as the basis for targeting an individual or group with abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Bosniac</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Bystander -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Bystander">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#ParticipantRole"/>
        <rdfs:comment xml:lang="en">Represents a participant who observes an abusive interaction without directly participating in, supporting, or opposing the abusive behavior.</rdfs:comment>
        <rdfs:label xml:lang="en">Bystander</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#CatchphraseFillerIdiom -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#CatchphraseFillerIdiom">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#LexicalUnit"/>
        <rdfs:comment xml:lang="en">Represents linguistic expressions catchphrase, filler and idiom.</rdfs:comment>
        <rdfs:label xml:lang="en">CatchphraseFillerIdiom</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Catholic -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Catholic">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#ReligiousBeliefs"/>
        <rdfs:comment xml:lang="en">Represents Catholic affiliation as the basis for abusive speech directed toward an individual or group.</rdfs:comment>
        <rdfs:label xml:lang="en">Catholic</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Classism -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Classism">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#HateConcept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#SocialStatus"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A form of social prejudice and discrimination involving negative attitudes, stereotyping, discriminatory actions, or institutional practices directed against individuals or groups based on their actual or perceived social class.</rdfs:comment>
        <rdfs:label xml:lang="en">Classism</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#CognitiveDisability -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#CognitiveDisability">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Disability"/>
        <owl:disjointWith rdf:resource="http://llod.jerteh.rs/alo/alo.owl#PhysicalDisability"/>
        <rdfs:comment xml:lang="en">Represents cognitive, intellectual, developmental, or learning disabilities as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">CognitiveDisability</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Colorism -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Colorism">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Lookism"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#SkinColour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Prejudice or discrimination against individuals with a darker skin tone, typically among people of the same ethnic or racial group.1 While related to physical appearance, it&apos;s a specific form of prejudice based on skin shade, often linked to internalized racism.</rdfs:comment>
        <rdfs:label xml:lang="en">Colorism</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Context -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Context">
        <rdfs:comment xml:lang="en">Represents the communication context or source in which a text is published or distributed, such as social media platforms or news articles.</rdfs:comment>
        <rdfs:label xml:lang="en">Context</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#CriminalActivity -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#CriminalActivity">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Behaviour"/>
        <rdfs:comment xml:lang="en">Represents actual or perceived involvement in criminal activity as the basis for abusive speech directed toward an individual or group.</rdfs:comment>
        <rdfs:label xml:lang="en">CriminalActivity</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Croatian -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Croatian">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Nationality"/>
        <rdfs:comment xml:lang="en">Represents Croatian national affiliation as a characteristic that may serve as the basis for targeting an individual or group with abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Croatian</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Dataset -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Dataset">
        <rdfs:comment xml:lang="en">A dataset which contains examples of abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Dataset</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#DatasetEntry -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#DatasetEntry">
        <rdfs:comment xml:lang="en">Class DatasetEntry represents a data record in dataset.</rdfs:comment>
        <rdfs:label xml:lang="en">DatasetEntry</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Defamation -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Defamation">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Intention"/>
        <rdfs:comment xml:lang="en">Represents the intention to damage the reputation of an individual or group through false or harmful statements.</rdfs:comment>
        <rdfs:label xml:lang="en">Defamation</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Derogation -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Derogation">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Intention"/>
        <rdfs:comment xml:lang="en">Represents the intention to demean, belittle, or diminish the perceived value or dignity of an individual or group.</rdfs:comment>
        <rdfs:label xml:lang="en">Derogation</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Derogatory -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Derogatory">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbuseCategory"/>
        <rdfs:comment xml:lang="en">Derogatory speech (DS), a tweet is used to attack or humiliate an individual or group in a general sense, not in a way hate speech does.</rdfs:comment>
        <rdfs:label xml:lang="en">Derogatory</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Desease -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Desease">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents disease or medical conditions as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Desease</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Disability -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Disability">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents disability as a characteristic on the basis of which a person or group may be targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Disability</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Discrimination -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Discrimination">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Intention"/>
        <rdfs:comment xml:lang="en">Represents the intention to promote or justify discriminatory treatment of an individual or group based on protected or social characteristics.</rdfs:comment>
        <rdfs:label xml:lang="en">Discrimination</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Disparagement -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Disparagement">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Intention"/>
        <rdfs:comment xml:lang="en">Represents the intention to express contempt or disrespect toward an individual or group through belittling or offensive language.</rdfs:comment>
        <rdfs:label xml:lang="en">Disparagement</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Disrespect -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Disrespect">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Intention"/>
        <rdfs:comment xml:lang="en">Represents the intention to express a lack of respect or regard toward an individual or group through abusive language.</rdfs:comment>
        <rdfs:label xml:lang="en">Disrespect</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#DrugAddiction -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#DrugAddiction">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Behaviour"/>
        <rdfs:comment xml:lang="en">Represents drug addiction or substance dependence as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">DrugAddiction</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Ephebiphobia -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Ephebiphobia">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Ageism"/>
        <rdfs:comment xml:lang="en">Ephebiphobia specifically denotes the fear, dislike, or irrational hatred of youth or adolescents. It describes a distinct negative attitude towards teenagers and young adults.</rdfs:comment>
        <rdfs:label xml:lang="en">Ephebiphobia</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Ethnicity -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Ethnicity">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents ethnicity as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Ethnicity</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#FemaleGenitalia -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#FemaleGenitalia">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#LexicalSourceConcept"/>
        <rdfs:comment xml:lang="en">Represents the semantic domain of female genital anatomy, encompassing abusive lexical expressions derived from or referring to female genital concepts.</rdfs:comment>
        <rdfs:label xml:lang="en">FemaleGenitalia</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#FemaleImmigrant -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#FemaleImmigrant">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Immigrant"/>
        <rdfs:comment xml:lang="en">Represents female immigrants as the target of abusive speech based on their immigrant status and gender.</rdfs:comment>
        <rdfs:label xml:lang="en">FemaleImmigrant</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Gender -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Gender">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents gender as the characteristic on the basis of which abusive speech is directed toward an individual or group.</rdfs:comment>
        <rdfs:label xml:lang="en">Gender</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#GenderIdentity -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#GenderIdentity">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents gender identity as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">GenderIdentity</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#German -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#German">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Nationality"/>
        <rdfs:comment xml:lang="en">Represents German national affiliation as a characteristic that may serve as the basis for targeting an individual or group with abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">German</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Gerontophobia -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Gerontophobia">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Ageism"/>
        <rdfs:comment xml:lang="en">Gerontophobia refers to the fear, dislike, or irrational hatred of elderly people or of the process of aging itself.</rdfs:comment>
        <rdfs:label xml:lang="en">Gerontophobia</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Group -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Group">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Target"/>
        <rdfs:comment xml:lang="en">Represents a social, demographic, cultural, religious, ethnic, or other identifiable group targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Group</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#HateConcept -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#HateConcept">
        <rdfs:comment xml:lang="en">A class which represents a conceptual category of hate or prejudice directed toward individuals or groups based on shared protected or social characteristics, such as race, ethnicity, gender, age, disability, religion, or sexual orientation.</rdfs:comment>
        <rdfs:label xml:lang="en">HateConcept</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#HateSpeech -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#HateSpeech">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbuseCategory"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#hasTarget"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Target"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#hasTargetGroup"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetGroup"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Hearing -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Hearing">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#PhysicalDisability"/>
        <owl:disjointWith rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Sight"/>
        <rdfs:comment xml:lang="en">Represents hearing disabilities or impairments as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Hearing</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Height -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Height">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#PhysicalAppearance"/>
        <rdfs:comment xml:lang="en">Represents height as the physical characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Height</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Homophobia -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Homophobia">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AntiLGBTQPlus"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#HomosexualPerson"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Homophobia is the fear, hatred, discomfort, prejudice, discrimination, or aversion directed towards homosexual people (gay men and lesbians) or homosexuality itself.</rdfs:comment>
        <rdfs:label xml:lang="en">Homophobia</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#HomosexualPerson -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#HomosexualPerson">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#SexualOrientation"/>
        <rdfs:comment xml:lang="en">Represents homosexual individuals or groups as the targets of abusive speech based on their sexual orientation.</rdfs:comment>
        <rdfs:label xml:lang="en">HomosexualPerson</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Hurt -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Hurt">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Incitement"/>
        <rdfs:comment xml:lang="en">Represents incitement encouraging or advocating hurted against an individual or group.</rdfs:comment>
        <rdfs:label xml:lang="en">Hurt</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Immigrant -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Immigrant">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents real or perceived immigrant status as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Immigrant</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Incitement -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Incitement">
        <rdfs:comment xml:lang="en">Represents a characteristic of abusive speech that encourages, advocates, or calls for harmful actions, such as discrimination, segregation, or violence, against an individual or group.</rdfs:comment>
        <rdfs:comment xml:lang="en">The aim of abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Incitement</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Insult -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Insult">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Intention"/>
        <rdfs:comment xml:lang="en">Represents the intention to insult, demean, or humiliate an individual or group through abusive language.</rdfs:comment>
        <rdfs:label xml:lang="en">Insult</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Intelligence -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Intelligence">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#CognitiveDisability"/>
        <rdfs:comment xml:lang="en">Represents intelligence as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Intelligence</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Intention -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Intention">
        <rdfs:comment xml:lang="en">Represents the communicative purpose or intended effect of abusive speech, describing what the speaker aims to achieve through the abusive expression.</rdfs:comment>
        <rdfs:label xml:lang="en">Intention</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Irony -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Irony">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#RhetoricalFigure"/>
        <rdfs:comment xml:lang="en">Represents a rhetorical figure in which the intended meaning differs from, or is opposite to, the literal meaning of the expression.</rdfs:comment>
        <rdfs:label xml:lang="en">Irony</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Jew -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Jew">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Nationality"/>
        <rdfs:comment xml:lang="en">Represents affiliation with the Jewish people as a characteristic that may serve as the basis for targeting an individual or group with abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Jew</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Language -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Language">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents language as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Language</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#LexicalSourceConcept -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#LexicalSourceConcept">
        <rdfs:comment xml:lang="en">Represents the semantic domain of an abusive lexical expression, corresponding to the conceptual category from which the expression originates (e.g., animals, plants, professions, or diseases).</rdfs:comment>
        <rdfs:label xml:lang="en">LexicalSourceConcept</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#LexicalUnit -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#LexicalUnit">
        <rdfs:comment xml:lang="en">Represents a classification of lexical entries according to their lexical realization or conventional linguistic form, such as a single word, multiword expression, idiom, catchphrase, proverb, or similar lexical unit types.</rdfs:comment>
        <rdfs:label xml:lang="en">LexicalUnit</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Lookism -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Lookism">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#HateConcept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#PhysicalAppearance"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Lookism refers to prejudice or discrimination based on physical appearance and especially physical appearance believed to fall short of societal notions of beauty.</rdfs:comment>
        <rdfs:label xml:lang="en">Lookism</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#MaleGenitalia -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#MaleGenitalia">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#LexicalSourceConcept"/>
        <rdfs:comment xml:lang="en">Represents the semantic domain of male genital anatomy, encompassing abusive lexical expressions derived from or referring to male genital concepts.</rdfs:comment>
        <rdfs:label xml:lang="en">MaleGenitalia</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Malediction -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Malediction">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbuseCategory"/>
        <rdfs:comment xml:lang="sr">Kletva je svečana izjava, želja ili prizivanje natprirodne sile sa namerom da se nekome ili nečemu nanese zlo, kazna ili nesreća; čin proklinjanja. Ovo odgovara engleskom značenju &quot;invocation of harm / malediction&quot;. (&quot;Dabogda crk&apos;o&quot; je primer kletve).</rdfs:comment>
        <rdfs:comment xml:lang="en">Malediction (curse) is a solemn utterance or expressed wish intended to invoke a supernatural power to inflict harm, punishment, evil, or misfortune upon someone or something.</rdfs:comment>
        <rdfs:label xml:lang="en">Malediction</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Man -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Man">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Gender"/>
        <owl:disjointWith rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Woman"/>
        <rdfs:comment xml:lang="en">Represents men as the target of abusive speech based on their gender.</rdfs:comment>
        <rdfs:label xml:lang="en">Man</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Metaphor -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Metaphor">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#RhetoricalFigure"/>
        <rdfs:comment xml:lang="en">Represents a rhetorical figure in which a word or expression is used to refer to something to which it is not literally applicable, based on an implicit comparison.</rdfs:comment>
        <rdfs:label xml:lang="en">Metaphor</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Misandry -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Misandry">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Sexism"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Man"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Misandry is the dislike of, contempt for, ingrained prejudice against, or hatred of men and boys. It is the parallel concept to misogyny.</rdfs:comment>
        <rdfs:label xml:lang="en">Misandry</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Misogyny -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Misogyny">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Sexism"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Woman"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Misogyny is the dislike of, contempt for, ingrained prejudice against, or hatred of women and girls. It is a specific form of sexism characterized by a hostile and often demeaning attitude towards women.</rdfs:comment>
        <rdfs:label xml:lang="en">Misogyny</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Muslim -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Muslim">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#ReligiousBeliefs"/>
        <rdfs:comment xml:lang="en">Represents Muslim affiliation as the basis for abusive speech directed toward an individual or group.</rdfs:comment>
        <rdfs:label xml:lang="en">Muslim</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Nationality -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Nationality">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents national affiliation as a characteristic that may serve as the basis for targeting an individual or group with abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Nationality</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#NewsArticle -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#NewsArticle">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Context"/>
        <rdfs:comment xml:lang="en">Represents a news article published by a news organization or media outlet, providing the context in which a text appears.</rdfs:comment>
        <rdfs:label xml:lang="en">NewsArticle</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#NonUrbanPerson -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#NonUrbanPerson">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents residence in or affiliation with a non-urban area as a characteristic that may serve as the basis for targeting an individual or group with abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">NonUrbanPerson</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Obesity -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Obesity">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Weight"/>
        <owl:disjointWith rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Thinness"/>
        <rdfs:comment xml:lang="en">Represents obesity as the physical characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Obesity</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Occupation -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Occupation">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Strong negative sentiments, prejudice, discrimination, and generalized negative stereotypes directed towards entire groups of individuals based solely on their chosen job.</rdfs:comment>
        <rdfs:label xml:lang="en">Occupation</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Offense -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Offense">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Intention"/>
        <rdfs:comment xml:lang="en">Represents the intention to offend or cause emotional distress to an individual or group through abusive language.</rdfs:comment>
        <rdfs:label xml:lang="en">Offense</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#OffensiveSpeech -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#OffensiveSpeech">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbuseCategory"/>
        <rdfs:comment xml:lang="en">Represents a category of abusive speech that captures offensive content aimed at insulting, offending, or violating norms of acceptable communication, without necessarily involving derogation, profanity, threat, or hate speech.</rdfs:comment>
        <rdfs:label xml:lang="en">OffensiveSpeech</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#OldPerson -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#OldPerson">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Age"/>
        <owl:disjointWith rdf:resource="http://llod.jerteh.rs/alo/alo.owl#YoungPerson"/>
        <rdfs:comment xml:lang="en">Represents older age as a target type in abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">OldPerson</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Opinion -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Opinion">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents expressed opinions, views, or statements as characteristics that may serve as the basis for targeting an individual or group with abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Opinion</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Organization -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Organization">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Target"/>
        <rdfs:comment xml:lang="en">Represents an organization, institution, company, or other organized entity that is the target of abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Organization</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Orthodox -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Orthodox">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#ReligiousBeliefs"/>
        <rdfs:comment xml:lang="en">Represents Orthodox Christian affiliation as the basis for abusive speech directed toward an individual or group.</rdfs:comment>
        <rdfs:label xml:lang="en">Orthodox</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#OtherTarget -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#OtherTarget">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Target"/>
        <rdfs:comment xml:lang="en">Target of abusive speech which is not in other defined categories</rdfs:comment>
        <rdfs:label xml:lang="en">OtherTarget</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#ParticipantRole -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#ParticipantRole">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Role"/>
        <rdfs:comment xml:lang="en">Represents the role assigned to a participant in an abusive communication event or interaction.</rdfs:comment>
        <rdfs:label xml:lang="en">ParticipantRole</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Perpetrator -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Perpetrator">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#ParticipantRole"/>
        <rdfs:comment xml:lang="en">Represents a participant who produces, initiates, or carries out abusive behavior toward another individual or group.</rdfs:comment>
        <rdfs:label xml:lang="en">Perpetrator</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Person -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Person">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Target"/>
        <rdfs:comment xml:lang="en">Represents an individual who is the target of abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#PhysicalAppearance -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#PhysicalAppearance">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents physical appearance as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">PhysicalAppearance</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#PhysicalDisability -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#PhysicalDisability">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Disability"/>
        <rdfs:comment xml:lang="en">Represents physical disabilities affecting mobility, motor function, or other physical capabilities as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">PhysicalDisability</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Plant -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Plant">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#LexicalSourceConcept"/>
        <rdfs:comment xml:lang="en">Represents the semantic domain of plants, encompassing abusive lexical expressions derived from or referring to plant concepts.</rdfs:comment>
        <rdfs:label xml:lang="en">Plant</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#PoliticalBeliefs -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#PoliticalBeliefs">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents political beliefs or political affiliation as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">PoliticalBeliefs</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Profanity -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Profanity">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbuseCategory"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#hasTarget"/>
                        <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Target"/>
                    </owl:Restriction>
                </owl:complementOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:complementOf>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#hasTargetGroup"/>
                        <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetGroup"/>
                    </owl:Restriction>
                </owl:complementOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Prostitution -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Prostitution">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Occupation"/>
        <rdfs:comment xml:lang="en">Represents individuals engaged in prostitution or sex work as the target of abusive speech based on their occupation.</rdfs:comment>
        <rdfs:label xml:lang="en">Prostitution</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Race -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Race">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents race as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Race</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Racism -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Racism">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#HateConcept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Race"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Represents prejudice, discrimination, hostility, or hatred directed toward individuals or groups based on their race, ethnicity, or perceived racial or ethnic origin.</rdfs:comment>
        <rdfs:label xml:lang="en">Racism</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Refugee -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Refugee">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents refugee status as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Refugee</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#RegionalIdentity -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#RegionalIdentity">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents regional identity or regional affiliation as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">RegionalIdentity</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#ReligiousBeliefs -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#ReligiousBeliefs">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents religious belief as the characteristic on the basis of which abusive speech is directed toward an individual or group.</rdfs:comment>
        <rdfs:label xml:lang="en">ReligiousBeliefs</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#ReligiousHatred -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#ReligiousHatred">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#HateConcept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#ReligiousBeliefs"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Religious harted refers specifically to intense dislike, animosity, or enmity directed towards individuals or groups on the basis of their religious (or non-religious) affiliation or beliefs.</rdfs:comment>
        <rdfs:label xml:lang="en">ReligiousHatred</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#RhetoricalFigure -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#RhetoricalFigure">
        <rdfs:comment xml:lang="en">Represents a rhetorical device or figure of speech that may be used to express abusive or offensive meaning.</rdfs:comment>
        <rdfs:label xml:lang="en">RhetoricalFigure</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Roma -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Roma">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Ethnicity"/>
        <rdfs:comment xml:lang="en">Represents belonging to Roma or Romani enthnicity as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Roma</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Sarcasm -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Sarcasm">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#RhetoricalFigure"/>
        <rdfs:comment xml:lang="en">Represents a rhetorical figure that uses irony, ridicule, or mockery to express contempt or criticism.</rdfs:comment>
        <rdfs:label xml:lang="en">Sarcasm</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#SayingsProverbs -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#SayingsProverbs">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#LexicalUnit"/>
        <rdfs:comment xml:lang="en">Represents sayings and proverbs that may convey abusive or offensive meaning.</rdfs:comment>
        <rdfs:label xml:lang="en">SayingsProverbs</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Segregation -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Segregation">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Incitement"/>
        <rdfs:comment xml:lang="en">Represents incitement encouraging the exclusion or segregation of an individual or group.</rdfs:comment>
        <rdfs:label xml:lang="en">Segregation</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Sentiment -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Sentiment">
        <rdfs:comment xml:lang="en">Represents the emotional polarity or attitude expressed toward a target, entity, or situation in a textual expression.</rdfs:comment>
        <rdfs:label xml:lang="en">Sentiment</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Serb -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Serb">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Nationality"/>
        <rdfs:comment xml:lang="en">Represents Serbian national affiliation as a characteristic that may serve as the basis for targeting an individual or group with abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Serb</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#SevenDeadlySins -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#SevenDeadlySins">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Behaviour"/>
        <rdfs:comment xml:lang="en">Represents behaviors or characteristics associated with the traditional seven deadly sins (e.g., pride, greed, envy, wrath, lust, gluttony, and sloth) as the basis for abusive speech directed toward an individual or group.</rdfs:comment>
        <rdfs:label xml:lang="en">SevenDeadlySins</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Sexism -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Sexism">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#HateConcept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Gender"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Sexism refers to prejudice, stereotyping, or discrimination, typically against women, on the basis of sex or gender.</rdfs:comment>
        <rdfs:comment xml:lang="en">The belief that one sex is superior to or more valuable than another (Britannica).</rdfs:comment>
        <rdfs:label xml:lang="en">Sexism</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#SexualOrientation -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#SexualOrientation">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Shorty -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Shorty">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Height"/>
        <owl:disjointWith rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Tallness"/>
        <rdfs:comment xml:lang="en">Represents short stature as the physical characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Shorty</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Sight -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Sight">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#PhysicalDisability"/>
        <rdfs:comment xml:lang="en">Represents visual disabilities or impairments as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Sight</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Sizeism -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Sizeism">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Lookism"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Weight"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Prejudice or discrimination on the grounds of a person&apos;s body size (e.g., against people who are overweight or underweight)</rdfs:comment>
        <rdfs:label xml:lang="en">Sizeism</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#SkinColour -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#SkinColour">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents skin colour as a characteristic that may serve as the basis for targeting an individual or group with abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">SkinColour</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Slur -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Slur">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbuseCategory"/>
        <rdfs:comment xml:lang="en">A slur is a derogatory or insulting term used to express contempt or prejudice against individuals or groups, typically based on their identity or perceived membership in a particular social group.</rdfs:comment>
        <rdfs:comment xml:lang="sr">Uvreda je pogrdni ili uvredljivi izraz koji se koristi za izražavanje prezira ili predrasuda prema pojedincima ili grupama, obično na osnovu njihovog identiteta ili percipirane pripadnosti određenoj društvenoj grupi.</rdfs:comment>
        <rdfs:label xml:lang="en">Slur</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#SocialMedia -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#SocialMedia">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Context"/>
        <rdfs:comment xml:lang="en">Represents a social media platform or post serving as the context in which a text is created, shared, or discussed.</rdfs:comment>
        <rdfs:label xml:lang="en">SocialMedia</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#SocialStatus -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#SocialStatus">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
        <rdfs:comment xml:lang="en">Represents social status as a characteristic that may serve as the basis for targeting an individual or group with abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">SocialStatus</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#SpeechIntrusion -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#SpeechIntrusion">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Behaviour"/>
        <rdfs:comment xml:lang="en">Represents intrusive or disruptive speech behavior as the basis for abusive speech directed toward an individual or group.</rdfs:comment>
        <rdfs:label xml:lang="en">SpeechIntrusion</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Stigmatization -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Stigmatization">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#HateConcept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Behaviour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Stigmatization involves negative attitudes and discriminatory behavior towards individuals based on their specific behaviors or conditions.</rdfs:comment>
        <rdfs:label xml:lang="en">Stigmatization</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#SwearWord -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#SwearWord">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Profanity"/>
        <rdfs:comment xml:lang="en">Profanities are derogatory, offensive, and indecent words used to hold something up to ridicule (Dictionary of Matica Srpska).</rdfs:comment>
        <rdfs:comment xml:lang="sr">Psovke su pogrdne, uvredljive, nepristojne riječi kojima se što izvrgava ruglu (Rečnik Matice srpske)</rdfs:comment>
        <rdfs:label xml:lang="en">SwearWord</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Tallness -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Tallness">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Height"/>
        <rdfs:comment xml:lang="en">Represents tall stature as the physical characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Tallness</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Target -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Target">
        <rdfs:comment xml:lang="en">Target of abusive speech can be person, group or other.</rdfs:comment>
        <rdfs:label xml:lang="en">Target</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#TargetGroup -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#TargetGroup">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#hasTargetType"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#TargetType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Target types are usually combined into target group based on some common characteristics.</rdfs:comment>
        <rdfs:label xml:lang="en">TargetGroup</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#TargetType -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#TargetType">
        <rdfs:comment xml:lang="en">Represents the characteristic or social category to which a targeted person or group belongs and on the basis of which abusive speech is directed toward them.</rdfs:comment>
        <rdfs:label xml:lang="en">TargetType</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Thinness -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Thinness">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Weight"/>
        <rdfs:comment xml:lang="en">Represents thinness as the physical characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Thinness</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Threat -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Threat">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#AbuseCategory"/>
        <rdfs:comment xml:lang="en">A statement of an intention to inflict pain, injury, damage, or other hostile action on someone in retribution for something done or not done.</rdfs:comment>
        <rdfs:label xml:lang="en">Threat</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Upstander -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Upstander">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#ParticipantRole"/>
        <rdfs:comment xml:lang="en">Represents a participant who intervenes in, challenges, reports, or opposes abusive behavior in support of the victim or targeted group.</rdfs:comment>
        <rdfs:label xml:lang="en">Upstander</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Victim -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Victim">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#ParticipantRole"/>
        <rdfs:comment xml:lang="en">Represents a participant or target who is subjected to abusive behavior or harmful communication.</rdfs:comment>
        <rdfs:label xml:lang="en">Victim</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Violence -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Violence">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Incitement"/>
        <rdfs:comment xml:lang="en">Represents incitement encouraging or advocating violence against an individual or group.</rdfs:comment>
        <rdfs:label xml:lang="en">Violence</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Walking -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Walking">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#PhysicalAppearance"/>
        <rdfs:comment xml:lang="en">Represents walking style or gait as the physical characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Walking</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Weight -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Weight">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#PhysicalAppearance"/>
        <rdfs:comment xml:lang="en">Represents body weight as the physical characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">Weight</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Woman -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Woman">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Gender"/>
        <rdfs:comment xml:lang="en">Represents women as the target of abusive speech based on their gender.</rdfs:comment>
        <rdfs:label xml:lang="en">Woman</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Wordplay -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Wordplay">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#RhetoricalFigure"/>
        <rdfs:comment xml:lang="en">A rhetorical technique or figure of speech characterized by the clever manipulation or exploitation of the sounds, meanings (especially polysemy or ambiguity), or form of words, typically intended to produce a humorous or witty effect.</rdfs:comment>
        <rdfs:label xml:lang="en">Wordplay</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#Xenophobia -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#Xenophobia">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#HateConcept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#Ethnicity"/>
                            <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#Immigrant"/>
                            <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#Nationality"/>
                            <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#Refugee"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Xenophobia is the dislike of or prejudice against people from other countries or who are perceived as foreign or strange. Since nationality is often tied to a country of origin, xenophobia directly addresses animosity towards individuals based on their national background when they are perceived as &quot;other&quot; or &quot;foreign.&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">Xenophobia</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#YoungPerson -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#YoungPerson">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Age"/>
        <rdfs:comment xml:lang="en">Represents younger age as a target type in abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">YoungPerson</rdfs:label>
    </owl:Class>
    


    <!-- http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#String -->

    <owl:Class rdf:about="http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#String">
        <rdfs:comment xml:lang="en">Class for connecting AbusiveText with NIF String class.</rdfs:comment>
        <rdfs:isDefinedBy xml:lang="en">nif:String</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">String</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2002/07/owl#Thing -->

    <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#Thing">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/lemon/ontolex#LexicalEntry -->

    <owl:Class rdf:about="http://www.w3.org/ns/lemon/ontolex#LexicalEntry">
        <rdfs:comment xml:lang="en">Represents a LexicalEntry concept reused from the Ontolex ontology</rdfs:comment>
        <rdfs:label xml:lang="en">LexicalEntry</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/lemon/ontolex#LexicalSense -->

    <owl:Class rdf:about="http://www.w3.org/ns/lemon/ontolex#LexicalSense">
        <rdfs:comment xml:lang="en">Represents a LexicalSense concept reused from the Ontolex ontology</rdfs:comment>
        <rdfs:label xml:lang="en">LexicalSense</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Activity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Activity">
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label>Activity</rdfs:label>
        <prov:category>starting-point</prov:category>
        <prov:component>entities-activities</prov:component>
        <prov:constraints rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig</prov:constraints>
        <prov:definition>An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities.</prov:definition>
        <prov:dm rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Activity</prov:dm>
        <prov:n rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Activity</prov:n>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Agent -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label>Agent</rdfs:label>
        <prov:category>starting-point</prov:category>
        <prov:component>agents-responsibility</prov:component>
        <prov:definition xml:lang="en">An agent is something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent&apos;s activity. </prov:definition>
        <prov:dm rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent</prov:dm>
        <prov:n rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Agent</prov:n>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Entity -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label>Entity</rdfs:label>
        <prov:constraints rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig</prov:constraints>
        <prov:definition>An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary.</prov:definition>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/prov#Role -->

    <owl:Class rdf:about="http://www.w3.org/ns/prov#Role">
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov-o#"/>
        <rdfs:label>Role</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#hadRole"/>
        <prov:category>qualified</prov:category>
        <prov:component>agents-responsibility</prov:component>
        <prov:definition xml:lang="en">A role is the function of an entity or agent with respect to an activity, in the context of a usage, generation, invalidation, association, start, and end.</prov:definition>
        <prov:dm rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribute-role</prov:dm>
        <prov:n rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-attribute</prov:n>
    </owl:Class>
    


