            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Represents prejudice, discrimination, hostility, or hatred directed toward individuals or groups based on their Albanian ethnic or national identity.</rdfs:comment>
        <rdfs:label xml:lang="en">AntiAlbanian</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AntiCatholic -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AntiCatholic">
