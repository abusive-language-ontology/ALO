                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#German"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Represents prejudice, discrimination, hostility, or hatred directed toward individuals or groups based on their German ethnic or national identity.</rdfs:comment>
        <rdfs:label xml:lang="en">AntiGerman</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AntiImmigrant -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AntiImmigrant">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Xenophobia"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://llod.jerteh.rs/alo/alo.owl#isDirectedAgainst"/>
                <owl:someValuesFrom rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Immigrant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Represents prejudice, discrimination, hostility, or hatred directed toward immigrants or individuals perceived to be immigrants.</rdfs:comment>
        <rdfs:label xml:lang="en">AntiImmigrant</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AntiLGBTQPlus -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AntiLGBTQPlus">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#HateConcept"/>
