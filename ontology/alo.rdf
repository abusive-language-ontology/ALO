            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Represents prejudice, discrimination, hostility, or hatred directed toward individuals or groups based on their Croatian ethnic or national identity.</rdfs:comment>
        <rdfs:label xml:lang="en">AntiCroatian</rdfs:label>
    </owl:Class>
    


    <!-- http://llod.jerteh.rs/alo/alo.owl#AntiGerman -->

    <owl:Class rdf:about="http://llod.jerteh.rs/alo/alo.owl#AntiGerman">
        <rdfs:subClassOf rdf:resource="http://llod.jerteh.rs/alo/alo.owl#Xenophobia"/>
