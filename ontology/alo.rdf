     -->

    <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#HateSpeech">
        <rdfs:comment xml:lang="en">Any communication that disparages a person or a group on the basis of some characteristic such as race, color, ethnicity, gender, sexual orientation, nationality, religion, or other characteristics (Basile et al., 2019).</rdfs:comment>
        <rdfs:label xml:lang="en">HateSpeech</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#Profanity">
        <rdfs:comment xml:lang="en">Profanity: This term encompasses a broader range of offensive language, including swearing, cursing, and other vulgar expressions. Profanity generally refers to language that is disrespectful or irreverent, especially towards sacred thing (Wikipedia)</rdfs:comment>
        <rdfs:comment xml:lang="en">Untargeted offensive language that is considered socially offensive due to being vulgar, obscene, or irreverent (Caselli et al., 2020, Britanicca).</rdfs:comment>
        <rdfs:label xml:lang="en">Profanity</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://llod.jerteh.rs/alo/alo.owl#SexualOrientation">
        <rdfs:comment xml:lang="en">Represents sexual orientation as the characteristic on the basis of which an individual or group is targeted by abusive speech.</rdfs:comment>
        <rdfs:label xml:lang="en">SexualOrientation</rdfs:label>
    </rdf:Description>
    


