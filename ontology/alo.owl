        <IRI>#Derogation</IRI>
        <Literal xml:lang="en">Derogation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Derogatory</IRI>
        <Literal xml:lang="en">Derogatory speech (DS), a tweet is used to attack or humiliate an individual or group in a general sense, not in a way hate speech does.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Derogatory</IRI>
        <Literal xml:lang="en">Derogatory</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Desease</IRI>
        <Literal xml:lang="en">Represents disease or medical conditions as the characteristic on the basis of which an individual or group is targeted by abusive speech.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Desease</IRI>
        <Literal xml:lang="en">Desease</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Disability</IRI>
        <Literal xml:lang="en">Represents disability as a characteristic on the basis of which a person or group may be targeted by abusive speech.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Disability</IRI>
        <Literal xml:lang="en">Disability</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Discrimination</IRI>
        <Literal xml:lang="en">Represents the intention to promote or justify discriminatory treatment of an individual or group based on protected or social characteristics.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Discrimination</IRI>
