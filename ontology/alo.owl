    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Shorty</IRI>
        <Literal xml:lang="en">Shorty</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Sight</IRI>
        <Literal xml:lang="en">Represents visual disabilities or impairments as the characteristic on the basis of which an individual or group is targeted by abusive speech.</Literal>
