    <Annotation>
        <AnnotationProperty abbreviatedIRI="terms:abstract"/>
        <Literal xml:lang="en">The ontology of abusive speech is designed for publishing results of the abusive language annotation process in a structured form. The goal is to have a placeholder for different dataset formats, to support diverse abusive language detection methodologies and content providers.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="terms:created"/>
        <Literal xml:lang="en">2025-03-01</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="terms:creator"/>
        <Literal xml:lang="en">Danka Jokic, University of Belgrade</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="terms:description"/>
        <Literal xml:lang="en">The ontology of abusive speech is designed for publishing results of the abusive language annotation process in a structured form. The goal is to have a placeholder for different dataset formats, to support diverse abusive language detection methodologies and content providers.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="terms:license"/>
        <IRI>https://creativecommons.org/licenses/by-nc-sa/4.0/</IRI>
    </Annotation>
    <Annotation>
