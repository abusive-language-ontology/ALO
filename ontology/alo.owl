    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Sight</IRI>
        <Literal xml:lang="en">Sight</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Sizeism</IRI>
        <Literal xml:lang="en">Prejudice or discrimination on the grounds of a person&apos;s body size (e.g., against people who are overweight or underweight)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Sizeism</IRI>
        <Literal xml:lang="en">Sizeism</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SkinColour</IRI>
        <Literal xml:lang="en">Represents skin colour as a characteristic that may serve as the basis for targeting an individual or group with abusive speech.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SkinColour</IRI>
        <Literal xml:lang="en">SkinColour</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Slur</IRI>
        <Literal xml:lang="en">A slur is a derogatory or insulting term used to express contempt or prejudice against individuals or groups, typically based on their identity or perceived membership in a particular social group.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Slur</IRI>
        <Literal xml:lang="sr">Uvreda je pogrdni ili uvredljivi izraz koji se koristi za izražavanje prezira ili predrasuda prema pojedincima ili grupama, obično na osnovu njihovog identiteta ili percipirane pripadnosti određenoj društvenoj grupi.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Slur</IRI>
        <Literal xml:lang="en">Slur</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SocialMedia</IRI>
        <Literal xml:lang="en">Represents a social media platform or post serving as the context in which a text is created, shared, or discussed.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SocialMedia</IRI>
        <Literal xml:lang="en">SocialMedia</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SocialStatus</IRI>
        <Literal xml:lang="en">Represents social status as a characteristic that may serve as the basis for targeting an individual or group with abusive speech.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SocialStatus</IRI>
        <Literal xml:lang="en">SocialStatus</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SpeechIntrusion</IRI>
        <Literal xml:lang="en">Represents intrusive or disruptive speech behavior as the basis for abusive speech directed toward an individual or group.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SpeechIntrusion</IRI>
        <Literal xml:lang="en">SpeechIntrusion</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Stigmatization</IRI>
        <Literal xml:lang="en">Stigmatization involves negative attitudes and discriminatory behavior towards individuals based on their specific behaviors or conditions.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Stigmatization</IRI>
        <Literal xml:lang="en">Stigmatization</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SwearWord</IRI>
        <Literal xml:lang="en">Profanities are derogatory, offensive, and indecent words used to hold something up to ridicule (Dictionary of Matica Srpska).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SwearWord</IRI>
        <Literal xml:lang="sr">Psovke su pogrdne, uvredljive, nepristojne riječi kojima se što izvrgava ruglu (Rečnik Matice srpske)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SwearWord</IRI>
        <Literal xml:lang="en">SwearWord</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Tallness</IRI>
        <Literal xml:lang="en">Represents tall stature as the physical characteristic on the basis of which an individual or group is targeted by abusive speech.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Tallness</IRI>
        <Literal xml:lang="en">Tallness</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Target</IRI>
        <Literal xml:lang="en">Target of abusive speech can be person, group or other.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Target</IRI>
        <Literal xml:lang="en">Target</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#TargetGroup</IRI>
        <Literal xml:lang="en">Target types are usually combined into target group based on some common characteristics.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TargetGroup</IRI>
        <Literal xml:lang="en">TargetGroup</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#TargetType</IRI>
        <Literal xml:lang="en">Represents the characteristic or social category to which a targeted person or group belongs and on the basis of which abusive speech is directed toward them.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TargetType</IRI>
        <Literal xml:lang="en">TargetType</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Thinness</IRI>
        <Literal xml:lang="en">Represents thinness as the physical characteristic on the basis of which an individual or group is targeted by abusive speech.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Thinness</IRI>
        <Literal xml:lang="en">Thinness</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Threat</IRI>
        <Literal xml:lang="en">A statement of an intention to inflict pain, injury, damage, or other hostile action on someone in retribution for something done or not done.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Threat</IRI>
        <Literal xml:lang="en">Threat</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Upstander</IRI>
        <Literal xml:lang="en">Represents a participant who intervenes in, challenges, reports, or opposes abusive behavior in support of the victim or targeted group.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Upstander</IRI>
        <Literal xml:lang="en">Upstander</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Victim</IRI>
        <Literal xml:lang="en">Represents a participant or target who is subjected to abusive behavior or harmful communication.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Victim</IRI>
        <Literal xml:lang="en">Victim</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Violence</IRI>
        <Literal xml:lang="en">Represents incitement encouraging or advocating violence against an individual or group.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Violence</IRI>
        <Literal xml:lang="en">Violence</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Walking</IRI>
        <Literal xml:lang="en">Represents walking style or gait as the physical characteristic on the basis of which an individual or group is targeted by abusive speech.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Walking</IRI>
        <Literal xml:lang="en">Walking</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Weight</IRI>
        <Literal xml:lang="en">Represents body weight as the physical characteristic on the basis of which an individual or group is targeted by abusive speech.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Weight</IRI>
        <Literal xml:lang="en">Weight</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Woman</IRI>
        <Literal xml:lang="en">Represents women as the target of abusive speech based on their gender.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Woman</IRI>
        <Literal xml:lang="en">Woman</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Wordplay</IRI>
        <Literal xml:lang="en">A rhetorical technique or figure of speech characterized by the clever manipulation or exploitation of the sounds, meanings (especially polysemy or ambiguity), or form of words, typically intended to produce a humorous or witty effect.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Wordplay</IRI>
        <Literal xml:lang="en">Wordplay</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Xenophobia</IRI>
        <Literal xml:lang="en">Xenophobia is the dislike of or prejudice against people from other countries or who are perceived as foreign or strange. Since nationality is often tied to a country of origin, xenophobia directly addresses animosity towards individuals based on their national background when they are perceived as &quot;other&quot; or &quot;foreign.&quot;</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Xenophobia</IRI>
        <Literal xml:lang="en">Xenophobia</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#YoungPerson</IRI>
        <Literal xml:lang="en">Represents younger age as a target type in abusive speech.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#YoungPerson</IRI>
        <Literal xml:lang="en">YoungPerson</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#abusiveBoolean</IRI>
        <Literal xml:lang="en">Boolean, if 0 not abusive language, if 1 abusive language.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#abusiveBoolean</IRI>
        <Literal xml:lang="en">abusiveBoolean</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
