    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Sentiment</IRI>
        <Literal xml:lang="en">Represents the emotional polarity or attitude expressed toward a target, entity, or situation in a textual expression.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Sentiment</IRI>
        <Literal xml:lang="en">Sentiment</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Serb</IRI>
        <Literal xml:lang="en">Represents Serbian national affiliation as a characteristic that may serve as the basis for targeting an individual or group with abusive speech.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Serb</IRI>
        <Literal xml:lang="en">Serb</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SevenDeadlySins</IRI>
        <Literal xml:lang="en">Represents behaviors or characteristics associated with the traditional seven deadly sins (e.g., pride, greed, envy, wrath, lust, gluttony, and sloth) as the basis for abusive speech directed toward an individual or group.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SevenDeadlySins</IRI>
        <Literal xml:lang="en">SevenDeadlySins</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Sexism</IRI>
        <Literal xml:lang="en">Sexism refers to prejudice, stereotyping, or discrimination, typically against women, on the basis of sex or gender.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Sexism</IRI>
        <Literal xml:lang="en">The belief that one sex is superior to or more valuable than another (Britannica).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Sexism</IRI>
        <Literal xml:lang="en">Sexism</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SexualOrientation</IRI>
        <Literal xml:lang="en">Represents sexual orientation as the characteristic on the basis of which an individual or group is targeted by abusive speech.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SexualOrientation</IRI>
        <Literal xml:lang="en">SexualOrientation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
