        <Literal xml:lang="en">Represents an individual who is the target of abusive speech.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Person</IRI>
        <Literal xml:lang="en">Person</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#PhysicalAppearance</IRI>
        <Literal xml:lang="en">Represents physical appearance as the characteristic on the basis of which an individual or group is targeted by abusive speech.</Literal>
