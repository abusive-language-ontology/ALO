        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Action</IRI>
        <Literal xml:lang="en">2444AbusiveSpeechWholeTextSet1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Adultism</IRI>
        <Literal xml:lang="en">Adultism is a term used to describe the systemic bias, prejudice, and discrimination that adults (particularly those in positions of power) may hold or exhibit against young people.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Adultism</IRI>
        <Literal xml:lang="en">Adultism</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Age</IRI>
        <Literal xml:lang="en">Represents age as a characteristic on the basis of which an individual or group may be targeted by abusive speech.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Age</IRI>
        <Literal xml:lang="en">Age</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Ageism</IRI>
        <Literal xml:lang="en">Ageism refers to stereotyping, prejudice, and/or discrimination against individuals or groups on the basis of their age.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Ageism</IRI>
        <Literal xml:lang="en">Ageism</Literal>
    </AnnotationAssertion>
