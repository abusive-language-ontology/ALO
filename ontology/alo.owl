    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SayingsProverbs</IRI>
        <Literal xml:lang="en">SayingsProverbs</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Segregation</IRI>
        <Literal xml:lang="en">Represents incitement encouraging the exclusion or segregation of an individual or group.</Literal>
