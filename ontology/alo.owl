    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Disparagement</IRI>
        <Literal xml:lang="en">Represents the intention to express contempt or disrespect toward an individual or group through belittling or offensive language.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Disparagement</IRI>
        <Literal xml:lang="en">Disparagement</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Disrespect</IRI>
        <Literal xml:lang="en">Represents the intention to express a lack of respect or regard toward an individual or group through abusive language.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Disrespect</IRI>
        <Literal xml:lang="en">Disrespect</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#DrugAddiction</IRI>
        <Literal xml:lang="en">Represents drug addiction or substance dependence as the characteristic on the basis of which an individual or group is targeted by abusive speech.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#DrugAddiction</IRI>
        <Literal xml:lang="en">DrugAddiction</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Ephebiphobia</IRI>
        <Literal xml:lang="en">Ephebiphobia specifically denotes the fear, dislike, or irrational hatred of youth or adolescents. It describes a distinct negative attitude towards teenagers and young adults.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Ephebiphobia</IRI>
        <Literal xml:lang="en">Ephebiphobia</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Ethnicity</IRI>
        <Literal xml:lang="en">Represents ethnicity as the characteristic on the basis of which an individual or group is targeted by abusive speech.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Ethnicity</IRI>
        <Literal xml:lang="en">Ethnicity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#FemaleGenitalia</IRI>
        <Literal xml:lang="en">Represents the semantic domain of female genital anatomy, encompassing abusive lexical expressions derived from or referring to female genital concepts.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#FemaleGenitalia</IRI>
        <Literal xml:lang="en">FemaleGenitalia</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
