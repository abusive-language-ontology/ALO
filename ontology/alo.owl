    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#BisexualPerson</IRI>
        <Literal xml:lang="en">BisexualPerson</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
