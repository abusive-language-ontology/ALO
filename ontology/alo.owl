        <Literal xml:lang="en">Represents the semantic domain of plants, encompassing abusive lexical expressions derived from or referring to plant concepts.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Plant</IRI>
