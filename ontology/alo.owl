    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="terms:title"/>
        <Literal xml:lang="en">Abusive Language Ontology (Alo)</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="vann:preferredNamespacePrefix"/>
        <Literal xml:lang="en">alo</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="vann:preferredNamespacePrefix"/>
