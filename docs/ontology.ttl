#################################################################
#    Annotations
#################################################################

:HateSpeech rdfs:comment "Any communication that disparages a person or a group on the basis of some characteristic such as race, color, ethnicity, gender, sexual orientation, nationality, religion, or other characteristics (Basile et al., 2019)."@en ;
            rdfs:label "HateSpeech"@en .


:Profanity rdfs:comment "Profanity: This term encompasses a broader range of offensive language, including swearing, cursing, and other vulgar expressions. Profanity generally refers to language that is disrespectful or irreverent, especially towards sacred thing (Wikipedia)"@en ,
                        "Untargeted offensive language that is considered socially offensive due to being vulgar, obscene, or irreverent (Caselli et al., 2020, Britanicca)."@en ;
           rdfs:label "Profanity"@en .


:SexualOrientation rdfs:comment "Represents sexual orientation as the characteristic on the basis of which an individual or group is targeted by abusive speech."@en ;
                   rdfs:label "SexualOrientation"@en .


